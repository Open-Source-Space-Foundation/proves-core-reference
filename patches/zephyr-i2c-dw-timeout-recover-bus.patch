+/* Why the driver called the recovery callback, and its state at that point:
+ * reason (I2C_DW_RECOVERY_*), IC_INTR_MASK, xfr_len, rx_pending,
+ * request_bytes, state, xfr_flags and the messages left. Valid inside the
+ * callback.
+ */
+#define I2C_DW_RECOVERY_TIMEOUT 1 /* a transfer timed out */
+#define I2C_DW_RECOVERY_STUCK   2 /* a new transfer found stuck or abort bits in state */
+static uint32_t i2c_dw_recovery_info[8];
+
+void i2c_dw_get_recovery_info(uint32_t info[8])
+{
+	memcpy(info, i2c_dw_recovery_info, sizeof(i2c_dw_recovery_info));
+}
+
 /* it might call from i2c_transfer api and have already
  * lock the bus, no need to lock bus again here
  */
@@ -822,6 +836,8 @@ static int i2c_dw_transfer(const struct device *dev, struct i2c_msg *msgs, uint8
 
 	/* check if the state is sda/scl stuck at low state */
 	if (dw->state & I2C_DW_STUCK_ERR_MASK) {
+		i2c_dw_recovery_info[0] = I2C_DW_RECOVERY_STUCK;
+		i2c_dw_recovery_info[5] = dw->state;
 		/* try to recovery */
 		if (i2c_recovery_bus(dev)) {
 			ret = -ETIME;
@@ -914,6 +930,21 @@ static int i2c_dw_transfer(const struct device *dev, struct i2c_msg *msgs, uint8
 		/* Wait for transfer to be done */
 		ret = k_sem_take(&dw->device_sync_sem, K_MSEC(CONFIG_I2C_DW_RW_TIMEOUT_MS));
 		if (ret != 0) {
+			i2c_dw_recovery_info[0] = I2C_DW_RECOVERY_TIMEOUT;
+			i2c_dw_recovery_info[1] = sys_read32(reg_base + DW_IC_REG_INTR_MASK);
+			i2c_dw_recovery_info[2] = dw->xfr_len;
+			i2c_dw_recovery_info[3] = dw->rx_pending;
+			i2c_dw_recovery_info[4] = dw->request_bytes;
+			i2c_dw_recovery_info[5] = dw->state;
+			i2c_dw_recovery_info[6] = dw->xfr_flags;
+			i2c_dw_recovery_info[7] = msg_left;
+			write_intr_mask(DW_DISABLE_ALL_I2C_INT, reg_base);
+			/* A timeout can leave the controller or the bus stuck (for example a
+			 * controller that never saw a STOP). Let the registered callback
+			 * record that state and recover both before the abort below
+			 * changes it.
+			 */
+			(void)i2c_recovery_bus(dev);
