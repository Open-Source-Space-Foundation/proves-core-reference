+/* Driver state of the last transfer that timed out on a bus with a recovery
+ * callback: IC_INTR_MASK, xfr_len, rx_pending, request_bytes, state,
+ * xfr_flags and the messages left. Valid inside the callback.
+ */
+static uint32_t i2c_dw_timeout_info[7];
+
+void i2c_dw_get_timeout_info(uint32_t info[7])
+{
+	memcpy(info, i2c_dw_timeout_info, sizeof(i2c_dw_timeout_info));
+}
+
 /* it might call from i2c_transfer api and have already
  * lock the bus, no need to lock bus again here
  */
@@ -914,6 +925,22 @@ static int i2c_dw_transfer(const struct device *dev, struct i2c_msg *msgs, uint8
 		/* Wait for transfer to be done */
 		ret = k_sem_take(&dw->device_sync_sem, K_MSEC(CONFIG_I2C_DW_RW_TIMEOUT_MS));
 		if (ret != 0) {
+			if (dw->recover_bus_cb) {
+				i2c_dw_timeout_info[0] = sys_read32(reg_base + DW_IC_REG_INTR_MASK);
+				i2c_dw_timeout_info[1] = dw->xfr_len;
+				i2c_dw_timeout_info[2] = dw->rx_pending;
+				i2c_dw_timeout_info[3] = dw->request_bytes;
+				i2c_dw_timeout_info[4] = dw->state;
+				i2c_dw_timeout_info[5] = dw->xfr_flags;
+				i2c_dw_timeout_info[6] = msg_left;
+			}
+			write_intr_mask(DW_DISABLE_ALL_I2C_INT, reg_base);
+			/* A timeout can leave the controller or the bus stuck (for example a
+			 * controller that never saw a STOP). Let the registered callback
+			 * record that state and recover both before the abort below
+			 * changes it.
+			 */
+			(void)i2c_recovery_bus(dev);
 			if (test_bit_con_master_mode(reg_base)) {
 				/* Trigger abort and wait for it to complete. */
 				set_bit_enable_abort(reg_base);
