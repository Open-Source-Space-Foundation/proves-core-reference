 	return res;
 }
 
+/* Channel mask the driver last selected on this root. Lets a bus recovery
+ * callback tell which channel a stuck transfer was on.
+ */
+uint8_t tca954x_selected_channel(const struct device *root)
+{
+	const struct tca954x_root_data *data = root->data;
+
+	return data->selected_chan;
+}
+
+/* Tell the driver that the mux was reset, so that the next transfer selects
+ * its channel again instead of trusting the cached one.
+ */
+void tca954x_forget_channel(const struct device *root)
+{
+	struct tca954x_root_data *data = root->data;
+
+	data->selected_chan = 0;
+}
