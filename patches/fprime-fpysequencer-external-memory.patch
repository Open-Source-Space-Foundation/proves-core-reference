+// Allocates the sequence file buffer, the statement table and the runtime stack. Together they are
+// most of the component's memory, so they can come from a different memory than the component.
+// The file buffer is set last: until it is, validate() rejects every sequence, so the table and
+// stack are never touched unallocated.
 void FpySequencer::allocateBuffer(FwEnumStoreType identifier, Fw::MemAllocator& allocator, FwSizeType bytes) {
     // if this assertion fails, you aren't allocating enough bytes for the
     // FpySequencer. this is because you must have a buffer big enough to fit the
     // header of a sequence
     FW_ASSERT(bytes >= Fpy::Header::SERIALIZED_SIZE, static_cast<FwAssertArgType>(bytes));
-    FwSizeType originalBytes = bytes;
-    bool recoverable = false;
+    FW_ASSERT(this->m_statements == nullptr);
     this->m_allocatorId = identifier;
+
+    FwSizeType statementBytes = sizeof(Fpy::Statement) * Fpy::MAX_SEQUENCE_STATEMENT_COUNT;
+    const FwSizeType requestedStatementBytes = statementBytes;
+    bool recoverable = false;
+    void* statementMemory = allocator.allocate(identifier, statementBytes, recoverable, alignof(Fpy::Statement));
+    FW_ASSERT(statementMemory != nullptr && statementBytes >= requestedStatementBytes,
+              static_cast<FwAssertArgType>(statementBytes));
+    this->m_statements = static_cast<Fpy::Statement*>(statementMemory);
+    for (FwSizeType i = 0; i < Fpy::MAX_SEQUENCE_STATEMENT_COUNT; i++) {
+        new (&this->m_statements[i]) Fpy::Statement();
+    }
+
+    FwSizeType stackBytes = Fpy::MAX_STACK_SIZE;
+    U8* stackMemory = static_cast<U8*>(allocator.allocate(identifier, stackBytes, recoverable));
+    FW_ASSERT(stackMemory != nullptr && stackBytes >= Fpy::MAX_STACK_SIZE, static_cast<FwAssertArgType>(stackBytes));
+    (void)memset(stackMemory, 0, Fpy::MAX_STACK_SIZE);
+    this->m_stackBytes = stackMemory;
+    this->m_runtime.stack.bytes = stackMemory;
+
+    FwSizeType originalBytes = bytes;
     U8* allocatedMemory = static_cast<U8*>(allocator.allocate(identifier, bytes, recoverable));
     // if this fails, unable to allocate the requested amount of money
-    FW_ASSERT(bytes >= originalBytes, static_cast<FwAssertArgType>(bytes));
+    FW_ASSERT(allocatedMemory != nullptr && bytes >= originalBytes, static_cast<FwAssertArgType>(bytes));
     this->m_sequenceBuffer.setExtBuffer(allocatedMemory, bytes);
 }
 
 void FpySequencer::deallocateBuffer(Fw::MemAllocator& allocator) {
     allocator.deallocate(this->m_allocatorId, this->m_sequenceBuffer.getBuffAddr());
     this->m_sequenceBuffer.clear();
+    this->m_runtime.stack.bytes = nullptr;
+    allocator.deallocate(this->m_allocatorId, this->m_stackBytes);
+    this->m_stackBytes = nullptr;
+    if (this->m_statements != nullptr) {
+        for (FwSizeType i = 0; i < Fpy::MAX_SEQUENCE_STATEMENT_COUNT; i++) {
+            this->m_statements[i].~Statement();
+        }
+        allocator.deallocate(this->m_allocatorId, this->m_statements);
+        this->m_statements = nullptr;
+    }
 }
 
