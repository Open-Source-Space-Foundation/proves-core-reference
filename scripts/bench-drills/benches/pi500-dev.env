# Pi500 DEV bench (host user `proves`). Dev FC plus a bench GRC plugged in next to it.
# Every value the drills use comes from this file; an environment variable of the
# same name overrides it. A value starting with TODO fails loudly when a drill needs it.
# The dev bench's own openocd server owns ports 3333/4444/6666; the drills refuse them.

BENCH_HOST_LABEL=pi500-dev
LOG_ROOT=${HOME}/bench-drill-logs
PCR=${HOME}/proves-core-reference
OPENOCD=${PCR}/tools/openocd/src/openocd
OPENOCD_SCRIPTS=${PCR}/tools/openocd/tcl

# Flight: dev FC, USB serial E4654080833E5D2A. Probe UART is /dev/ttyDEVPROBE.
FLIGHT_TTY=/dev/ttyDEVBOARD
FLIGHT_PROBE_SERIAL=E6647C74034E602F
FLIGHT_OPENOCD_GDB=3340
FLIGHT_OPENOCD_TELNET=4450
FLIGHT_OPENOCD_TCL=6670
FLIGHT_OPENOCD_LOG=${LOG_ROOT}/openocd-flight.log
FLIGHT_RTT_SHELL_PORT=9091
FLIGHT_REPO=${PCR}
FLIGHT_VENV=${PCR}/fprime-venv
FLIGHT_ELF=${PCR}/build-artifacts/zephyr.elf
FLIGHT_DICT=${PCR}/build-artifacts/zephyr/fprime-zephyr-deployment/dict/ReferenceDeploymentTopologyDictionary.json
FLIGHT_GDS_LOGS=${LOG_ROOT}/gds-flight
FLIGHT_GUI_PORT=5010
FLIGHT_ZMQ_IN=ipc:///tmp/drill-flight-in
FLIGHT_ZMQ_OUT=ipc:///tmp/drill-flight-out

# Bench GRC: PROVES Radio Stick V2, USB serial E9114582E1094947, flashed with
# GRC main f3b3985f3c8701e49fdc8117069a1870fd67199d. That build runs the legacy
# Zephyr LoRa driver (no USP, no profile commands), so profile drills FAIL on it.
# No debug probe: GRC_PROBE_SERIAL=none makes the GRC halted check N/A.
# GRC_BUILD is the Mac NVMe checkout; point it at the Pi500 copy when running there.
GRC_TTY=/dev/serial/by-id/usb-F_Prime_Ground_Radio_Controller_E9114582E1094947-if00
GRC_DATA_TTY=/dev/serial/by-id/usb-F_Prime_Ground_Radio_Controller_E9114582E1094947-if02
GRC_BAUD=115200
GRC_PROBE_SERIAL=none
GRC_BUILD=/Volumes/nvme-1tb-m4/proves/grc-builds/main-f3b3985
GRC_REPO=${GRC_BUILD}
GRC_VENV=${GRC_BUILD}/fprime-venv
GRC_ELF=${GRC_BUILD}/build-artifacts/zephyr.elf
GRC_ELF_SHA256=884bce897ce2d47a5c2c0eebca9ae30008a003bebe433fbf5acc33d3cb3be5fd
GRC_DICT=${GRC_BUILD}/build-artifacts/zephyr/fprime-zephyr-deployment/dict/ReferenceDeploymentTopologyDictionary.json
GRC_GDS_LOGS=${LOG_ROOT}/gds-grc
GRC_GUI_PORT=5011
GRC_ZMQ_IN=ipc:///tmp/drill-grc-in
GRC_ZMQ_OUT=ipc:///tmp/drill-grc-out

# D6 only: legacy GRC (GRC main, SX1276) and the flight GDS that talks through it.
LEGACY_TTY=TODO-legacy-grc-console-tty
LEGACY_DATA_TTY=TODO-legacy-grc-data-cdc-tty
LEGACY_PROBE_SERIAL=TODO-legacy-grc-probe-serial
LEGACY_OPENOCD_GDB=3342
LEGACY_OPENOCD_TELNET=4452
LEGACY_OPENOCD_TCL=6672
LEGACY_OPENOCD_LOG=${LOG_ROOT}/openocd-legacy.log
LEGACY_REPO=TODO-ground-radio-controller-main-checkout
LEGACY_VENV=${LEGACY_REPO}/venv
LEGACY_ELF=${LEGACY_REPO}/build-artifacts/zephyr.elf
LEGACY_DICT=${LEGACY_REPO}/build-artifacts/zephyr/fprime-zephyr-deployment/dict/ReferenceDeploymentTopologyDictionary.json
LEGACY_GDS_LOGS=${LOG_ROOT}/gds-legacy
LEGACY_GUI_PORT=5012
LEGACY_ZMQ_IN=ipc:///tmp/drill-legacy-in
LEGACY_ZMQ_OUT=ipc:///tmp/drill-legacy-out
RF_TTY=${LEGACY_DATA_TTY}
RF_REPO=${PCR}
RF_VENV=${FLIGHT_VENV}
RF_DICT=${FLIGHT_DICT}
RF_GDS_LOGS=${LOG_ROOT}/gds-rf
RF_GUI_PORT=5013
RF_ZMQ_IN=ipc:///tmp/drill-rf-in
RF_ZMQ_OUT=ipc:///tmp/drill-rf-out
